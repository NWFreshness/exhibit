# Local dev: docker Postgres on host port 5433.
DATABASE_URL="postgresql://exhibit:exhibit@localhost:5433/exhibit"
DATABASE_URL_TEST="postgresql://exhibit:exhibit@localhost:5433/exhibit_test"
# Auth.js
AUTH_SECRET="change-me-in-production-min-32-chars-xxxxxxxx"
AUTH_URL="http://localhost:3000"
# Email provider for magic links. Leave empty in dev: the link is shown on screen.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Exhibit <noreply@example.org>"
# District sign-in (Google first, Microsoft Entra second). Disabled unless set.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_ENTRA_CLIENT_ID=""
MICROSOFT_ENTRA_CLIENT_SECRET=""
MICROSOFT_ENTRA_TENANT_ID=""
# One OpenAI-compatible client (local or hosted endpoint, same call).
LLM_BASE_URL=""
LLM_API_KEY=""
LLM_MODEL="default"
# Tests force the stub; never call a real model from tests.
LLM_STUB=""
# Monthly renewal cron (Vercel cron hits /api/cron/renewals with this bearer token).
CRON_SECRET=""
# Vercel Blob. Empty in dev: files fall back to ./blob-local/ (dev only).
BLOB_READ_WRITE_TOKEN=""
